{
  "kind": "collectionType",
  "collectionName": "enquiries",
  "info": {
    "singularName": "enquiry",
    "pluralName": "enquiries",
    "displayName": "Enquiry",
    "description": "Executive advisory enquiries from contact form"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "topic": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "submittedAt": {
      "type": "datetime"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "reviewed", "replied", "archived"],
      "default": "new"
    }
  }
}

