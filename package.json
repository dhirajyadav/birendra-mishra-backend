{
  "name": "birendra-mishra-backend",
  "version": "1.0.0",
  "description": "Strapi 5 Headless CMS & LinkedIn Publishing Backend for Birendra Mishra",
  "private": true,
  "scripts": {
    "develop": "node scripts/run-node.js node_modules/@strapi/strapi/bin/strapi.js develop",
    "start": "node scripts/run-node.js node_modules/@strapi/strapi/bin/strapi.js start",
    "build": "node scripts/run-node.js node_modules/@strapi/strapi/bin/strapi.js build && node scripts/copy-schemas.js",
    "strapi": "node scripts/run-node.js node_modules/@strapi/strapi/bin/strapi.js",
    "seed": "node scripts/seed.js",
    "probe": "node scripts/probe-strapi.js"
  },
  "dependencies": {
    "@ckeditor/strapi-plugin-ckeditor": "^1.1.2",
    "@strapi/plugin-users-permissions": "5.10.1",
    "@strapi/strapi": "5.10.1",
    "axios": "^1.7.9",
    "better-sqlite3": "11.8.1",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pg-connection-string": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@swc/wasm": "^1.16.22",
    "@types/node": "^20.17.14",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "bm-strapi-5-prod"
  }
}
